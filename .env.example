# 复制为 .env 后按需修改；compose 会自动读取同目录的 .env
# 访问密码：至少 8 位，必填
MICA_PASSWORD=change-me-please

# 宿主机 ROM 目录（挂载到容器内 /roms）；可写 ./roms 或绝对路径
ROM_ROOT=./roms

# 对外端口
MICA_PORT=8088

# 运行用户；改成拥有 ROM 目录的 UID/GID（可用 `id` 查看）
PUID=1000
PGID=1000

TZ=Asia/Shanghai

# 可选：限制可在网页里添加的库目录（逗号分隔，默认 /roms）
MICA_LIBRARY_ROOTS=/roms

# 可选：用环境变量提供 AI Key，优先于网页设置
# MICA_AI_API_KEY=
